# Copy this file to .env and fill in your values

# A random string you choose — must match what you enter in Meta App Dashboard > WhatsApp > Configuration
WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here

# Your App Secret from Meta App Dashboard > Settings > Basic
APP_SECRET=your_app_secret_here

# Your WhatsApp Cloud API access token (temporary dev token or permanent system-user token)
ACCESS_TOKEN=your_whatsapp_access_token_here

# Port to listen on (default 3000)
PORT=3000
